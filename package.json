{
  "name": "@iamssen/exocortex",
  "version": "0.1.1",
  "type": "module",
  "author": "SSen",
  "license": "MIT",
  "main": "./model/index.ts",
  "types": "./model/index.ts",
  "exports": {
    ".": {
      "types": "./model/index.ts",
      "import": "./model/index.ts"
    },
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    }
  },
  "files": [
    "model",
    "server"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": "https://github.com/iamssen/exocortex",
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\"",
    "lint": "eslint .",
    "precommit": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,mts,cts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0",
      "vitest related"
    ],
    "**/*.{js,mjs,cjs,jsx}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "**/*.{json,css}": [
      "prettier --write"
    ],
    "server/**/*.{ts,mts,cts,tsx}": [
      "tsx scripts/gendoc.api.ts",
      "git add docs/api-list.yaml"
    ],
    "scripts/gendoc.api.ts": [
      "tsx scripts/gendoc.api.ts",
      "git add docs/api-list.yaml"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "^72.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "typescript": "^6",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
