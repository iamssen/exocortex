{
  "name": "@iamssen/exocortex",
  "version": "0.0.14",
  "type": "module",
  "author": "SSen",
  "license": "MIT",
  "main": "./dist/model.js",
  "types": "./dist/model.d.ts",
  "exports": {
    ".": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./date-utils": {
      "types": "./dist/date-utils.d.ts",
      "import": "./dist/date-utils.js"
    },
    "./projector": {
      "types": "./dist/projector.d.ts",
      "import": "./dist/projector.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": "https://github.com/iamssen/exocortex",
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\"",
    "lint": "eslint .",
    "build": "rimraf dist && rollup -c",
    "precommit": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,mts,cts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0",
      "vitest related"
    ],
    "**/*.{js,mjs,cjs,jsx}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "**/*.{json,css}": [
      "prettier --write"
    ],
    "server/**/*.{ts,mts,cts,tsx}": [
      "tsx scripts/gendoc.api.ts",
      "git add contexts/api.yaml"
    ],
    "scripts/gendoc.api.ts": [
      "tsx scripts/gendoc.api.ts",
      "git add contexts/api.yaml"
    ]
  },
  "dependencies": {
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/luxon": "~3.7.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-unicorn": "^62.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.2",
    "rollup": "^4.53.3",
    "rollup-plugin-dts": "^6.2.3",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.14"
  }
}
