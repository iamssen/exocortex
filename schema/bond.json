{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "amount": {
        "type": "number"
      },
      "purchase_price": {
        "type": "number"
      },
      "purchase_date": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "maturity_date": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "coupons": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "amount": {
              "type": "number"
            }
          },
          "required": ["date", "amount"]
        }
      }
    },
    "required": ["name", "amount", "purchase_price", "purchase_date", "maturity_date", "coupons"]
  }
}
