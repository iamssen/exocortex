{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "예금 (Deposits)",
  "description": "보유 중인 예금 및 적금 목록입니다.",
  "type": "array",
  "items": {
    "title": "예금 정보",
    "description": "개별 예금 상품의 상세 정보입니다.",
    "type": "object",
    "properties": {
      "name": {
        "title": "상품명",
        "description": "예금 상품의 이름입니다.",
        "type": "string",
        "examples": ["K뱅크 예금 25-12"]
      },
      "amount": {
        "title": "예치금",
        "description": "예치한 원금입니다.",
        "type": "number",
        "examples": [100000000]
      },
      "start": {
        "title": "시작일",
        "description": "예금 가입일입니다.",
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
        "examples": ["2025-11-26"]
      },
      "end": {
        "title": "만기일",
        "description": "예금 만기일입니다.",
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
        "examples": ["2026-11-26"]
      },
      "interest": {
        "title": "이자율",
        "description": "연 이자율(%)입니다.",
        "type": "number",
        "examples": [4.6]
      },
      "tax": {
        "title": "세율",
        "description": "이자 소득세율(%)입니다. 일반 과세의 경우 15.4%입니다.",
        "type": "number",
        "examples": [15.4]
      }
    },
    "required": ["name", "amount", "start", "end", "interest", "tax"]
  }
}
