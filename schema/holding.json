{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "symbol": {
        "type": "string"
      },
      "date": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "price": {
        "type": "number"
      },
      "quantity": {
        "type": "number"
      },
      "comment": {
        "type": "string"
      }
    },
    "required": ["symbol", "date", "price", "quantity"]
  }
}
