{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "링크 모음",
  "description": "자주 사용하는 웹사이트나 리소스의 링크 목록입니다.",
  "type": "array",
  "items": {
    "title": "링크 항목",
    "description": "개별 링크 정보입니다.",
    "type": "object",
    "examples": [
      {
        "title": "USD / KRW, TWD, EUR, JPY, CNY",
        "link": "https://www.google.com/finance/quote/USD-KRW?comparison=USD-TWD,USD-EUR,USD-JPY,USD-CNY&window=1Y",
        "matches": ["KRW=X"]
      },
      {
        "title": "M2 - US",
        "link": "https://tradingeconomics.com/united-states/money-supply-m2",
        "matches": ["DX-Y.NYB"]
      }
    ],
    "properties": {
      "title": {
        "title": "제목",
        "description": "링크의 표시 이름입니다.",
        "type": "string"
      },
      "link": {
        "title": "URL",
        "description": "이동할 웹사이트 주소입니다.",
        "type": "string"
      },
      "matches": {
        "title": "매칭 키워드",
        "description": "이 링크와 연관된 키워드 목록입니다. 검색이나 자동 연결에 사용될 수 있습니다.",
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": ["title", "link"]
  }
}
