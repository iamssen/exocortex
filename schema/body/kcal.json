{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "칼로리 기록 (Kcal Log)",
  "description": "날짜별 식단과 섭취 칼로리를 기록합니다.",
  "type": "object",
  "examples": [
    {
      "2025-10-25": {
        "9시 아침": { "샐러드 가득": 150, "4색 영양밥": 350 },
        "2시 점심": { "닭가슴살": 300, "4색 영양밥": 350 }
      }
    }
  ],
  "patternProperties": {
    "^[0-9]{4}-[0-9]{2}-[0-9]{2}$": {
      "title": "일별 기록",
      "description": "해당 날짜의 식단과 섭취 칼로리 기록입니다.",
      "type": "object",
      "additionalProperties": {
        "title": "식사 내역",
        "description": "식사 시간이나 끼니 종류 (예: '9시 아침', '점심')",
        "type": "object",
        "additionalProperties": {
          "title": "음식 및 칼로리",
          "description": "섭취한 음식 이름과 칼로리 (예: '사과': 50)",
          "type": "number"
        }
      }
    }
  },
  "additionalProperties": false
}
