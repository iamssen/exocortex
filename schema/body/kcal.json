{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "칼로리 기록 (Kcal Log)",
  "description": "날짜별 식단과 섭취 칼로리를 기록합니다.",
  "type": "object",
  "examples": [
    {
      "2025-10-25": {
        "9시 아침": { "샐러드 가득": 150, "4색 영양밥": 350 },
        "2시 점심": { "닭가슴살": 300, "4색 영양밥": 350 }
      }
    }
  ],
  "patternProperties": {
    "^[0-9]{4}-[0-9]{2}-[0-9]{2}$": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "additionalProperties": false
}
