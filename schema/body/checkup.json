            "적혈구수(RBC)": { "type": "number" },
            "적혈구수": { "type": "number" },
            "백혈구수(WBC)": { "type": "number" },
            "백혈구수": { "type": "number" },
            "혈소판수(Platelet)": { "type": "number" },
            "혈소판수": { "type": "number" },
            "적혈구용적(MCV)": { "type": "number" },
