            "적혈구혈혈색소농도(MCHC)": { "type": "number" },
            "RDW": { "type": "number" },
            "PDW": { "type": "number" },
            "MPV": { "type": "number" },
            "혈구용적치(HCT)": { "type": "number" },
            "분획호중구": { "type": "number" },
            "림프구": { "type": "number" },
            "호산구": { "type": "number" },
            "호염기구": { "type": "number" },
            "단핵구": { "type": "number" },
            "철(Fe)": { "type": "number" },
            "TIBC": { "type": "number" },
            "UIBC": { "type": "number" },
            "철포화율": { "type": "number" },
