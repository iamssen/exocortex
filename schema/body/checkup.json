              "description": "unit: mg/dL, 정상: [0.5, 1.4]"
            },
            "BUN/Creatinine 비율": {
              "type": "number",
              "description": "unit: %, 정상: [10, 20]"
            },
            "사구체여과율(GFR)": {
              "type": "number",
              "description": "정상: [60, null]"
            },
            "소견": { "type": "string" }
          },
          "additionalProperties": false
        },
        "소변검사": {
          "type": "object",
          "properties": {
            "요중백혈구(WBC)": { "type": ["string", "number"] },
            "요중적혈구(RBC)": { "type": "string" },
            "요중Nitrite": { "type": "string" },
            "pH": { "type": "number" },
            "요단백": { "type": "string" },
            "당": { "type": "string" },
            "요중케톤체량": { "type": "string" },
            "유로빌리노겐": { "type": "string" },
            "요빌리루빈": { "type": "string" },
            "요잠혈": { "type": "string" },
            "요비중(SG)": { "type": "number" },
            "소견": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "혈액 및 종양": {
