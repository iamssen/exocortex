{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "amount": {
        "type": "number"
      },
      "start": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "end": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "interest": {
        "type": "number"
      },
      "tax": {
        "type": "number"
      }
    },
    "required": ["name", "amount", "start", "end", "interest", "tax"]
  }
}
