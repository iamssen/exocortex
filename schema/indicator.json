{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "기간 표시 (Periodic Indicators)",
  "description": "특정 기간 동안 지속되는 이벤트나 특정일 기록입니다.",
  "type": "array",
  "items": {
    "title": "기간 이벤트",
    "description": "개별 기간 이벤트 정보입니다.",
    "oneOf": [
      {
        "title": "기간 이벤트",
        "type": "object",
        "description": "특정 기간 동안 지속되는 이벤트입니다.",
        "examples": [
          {
            "name": "내란",
            "from": "2024-12-03",
            "to": "2025-04-04"
          }
        ],
        "properties": {
          "name": {
            "title": "이벤트명",
            "description": "이벤트의 이름입니다.",
            "type": "string"
          },
          "from": {
            "title": "시작일",
            "description": "이벤트 시작 날짜입니다.",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "to": {
            "title": "종료일",
            "description": "이벤트 종료 날짜입니다.",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "required": ["name", "from", "to"]
      },
      {
        "title": "단일 이벤트",
        "type": "object",
        "description": "특정 날짜에 발생하는 이벤트입니다.",
        "examples": [
          {
            "name": "US -10%",
            "date": "2024-02-09"
          }
        ],
        "properties": {
          "name": {
            "title": "이벤트명",
            "description": "이벤트의 이름입니다.",
            "type": "string"
          },
          "date": {
            "title": "날짜",
            "description": "이벤트 발생 날짜입니다.",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "required": ["name", "date"]
      }
    ]
  }
}
